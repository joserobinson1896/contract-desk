# Copy this file to `.env` and replace the placeholder with your real key.
#
#     cp .env.example .env
#
# `.env` is gitignored and must stay that way — it is the only place a real key
# belongs. This file is committed, so it holds placeholders and nothing else.

# ---------------------------------------------------------------------------
# Gemini API key — used server-side by the /api/parse route for contract
# extraction and review. Read via process.env inside the route handler only.
#
# Create one at: https://aistudio.google.com/apikey
#
# NEVER prefix this with EXPO_PUBLIC_. That prefix inlines the value into the
# client bundle, which ships to every browser and is readable in devtools.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here

# ---------------------------------------------------------------------------
# Optional. Overrides the model used for extraction and review.
#
# EVERY UPLOAD IS TWO CALLS: one to transcribe, one to review. Measured on a
# three-page order form, ~6.3k input and ~7.7k output tokens per upload.
#
#   gemini-3.7-flash        (default)   ~29s   cheap
#   gemini-3.1-pro-preview              ~324s  materially more expensive
#
# Flash is the default because the quality floor does not come from the model:
# eighteen deterministic rules run over whatever is extracted, and the output is
# re-validated against the same schema either way. A weaker transcription shows
# up as findings to resolve, not as a silently wrong configuration.
#
# List what your key can reach with:
#   curl -s -H "x-goog-api-key: $GEMINI_API_KEY" \
#     https://generativelanguage.googleapis.com/v1beta/models
# ---------------------------------------------------------------------------
# GEMINI_MODEL=gemini-3.1-pro-preview
